// Examples can assume:
// late BuildContext context;
// late Widget myWidget;

/// The signature of [WidgetsApp.localeListResolutionCallback].
///
/// A [LocaleListResolutionCallback] is responsible for computing the locale of the app's
/// [Localizations] object when the app starts and when user changes the list of
/// locales for the device.
///
/// The [locales] list is the device's preferred locales when the app started, or the
/// device's preferred locales the user selected after the app was started. This list
/// is in order of preference. If this list is null or empty, then Flutter has not yet
/// received the locale information from the platform. The [supportedLocales] parameter
/// is just the value of [WidgetsApp.supportedLocales].
///
/// See also:
///
///  * [LocaleResolutionCallback], which takes only the first locale from [locales].
typedef LocaleListResolutionCallback = Locale? Function(List<Locale>? locales, Iterable<Locale> supportedLocales);

/// The signature of [WidgetsApp.localeResolutionCallback].
///
/// A [LocaleResolutionCallback] is responsible for computing the locale of the app's
/// [Localizations] object when the app starts and when user changes the locale for
/// the device.
///
/// The [locale] is the device's preferred locale when the app started, or the
/// device's locale the user selected after the app was started. The
/// [supportedLocales] parameter is just the value of [WidgetsApp.supportedLocales].
///
/// See also:
///
///  * [LocaleListResolutionCallback], which takes a list of preferred locales.
typedef LocaleResolutionCallback = Locale? Function(Locale? locale, Iterable<Locale> supportedLocales);

/// The signature of [WidgetsApp.onGenerateTitle].
///
/// Used to generate a value for the app's [Title.title], which the device uses
/// to identify the app for the user. The default is to use [WidgetsApp.title].
typedef GenerateAppTitle = String Function(BuildContext context);

/// The signature of [WidgetsApp.onGenerateInitialRoutes].
///
/// Used to generate a route tree for the application when the
/// [Navigator.initialRoute] is defined.
typedef InitialRouteListFactory = List<Route<dynamic>> Function(String initialRoute);

/// The signature of [WidgetsApp.pageRouteBuilder].
///
/// Used by [WidgetsApp] to define a [PageRoute] with the appropriate
/// [PageRoute.settings] in terms of a [RouteSettings] and a [WidgetBuilder].
typedef PageRouteFactory = Route<T> Function<T>(RouteSettings settings, WidgetBuilder builder);

/// A convenience class that wraps a number of widgets that are commonly
/// required for an application.
///
/// One of the primary roles that [WidgetsApp] provides is binding the system
/// back button to popping the [Navigator] or quitting the application.
///
/// It is used by both [MaterialApp] and [CupertinoApp] to implement base
/// functionality.
///
/// Find references to many of the widgets that [WidgetsApp] wraps in the "See
/// also" section.
///
/// See also:
///
///  * [CheckedModeBanner], which displays a banner in checked mode.
///  * [DefaultTextStyle], which defines a default configuration for [Text]
///    widgets.
///  * [MediaQuery], which establishes a subtree in which media queries resolve
///    to a [MediaQueryData].
///  * [Localizations], which defines the [Locale] for its `child`.
///  * [Title], which defines the title for the app to be used in the operating
///    system.
///  * [Navigator], which is a widget that manages a set of child widgets with a
///    stack discipline.
///  * [Overlay], which is a widget that manages a [OverlayEntry] objects.
///  * [SemanticsDebugger], which helps develop applications that are accessible
///    with [Semantics].
class WidgetsApp extends StatefulWidget {
  /// Creates a widget that wraps a number of widgets that are commonly
  /// required for an application.
  ///
  /// The boolean arguments, [color], [navigatorObservers], [pageRouteBuilder],
  /// [home], [routes], [onGenerateRoute], [onGenerateInitialRoutes],
  /// [onUnknownRoute], [builder], [title], [onGenerateTitle],
  /// [textStyle], [locale], [localizationsDelegates], [localeResolutionCallback],
  /// [localeListResolutionCallback], [supportedLocales], and [initialRoute],
  /// must not be null.
  ///
  /// Either the [home] argument or the [routes] argument must be
  /// non-null. If the [home] argument is non-null, it is a convenience for
  /// `routes[Navigator.defaultRouteName] = (BuildContext context) => home;`.
  ///
  /// The [pageRouteBuilder] argument must be non-null if the [home] argument is
  /// non-null, the [routes] argument is non-null, the [onGenerateRoute] argument
  /// is non-null, or the [onUnknownRoute] argument is non-null.
  ///
  /// The [builder] parameter is designed to provide the ability to wrap the
  /// navigator in custom widgets, such as those that provide hero animations or
  /// other transitions between routes.
  ///
  /// The [navigatorKey], [onGenerateRoute], [onGenerateInitialRoutes],
  /// [onUnknownRoute], [locale], [localizationsDelegates],
  /// [localeListResolutionCallback], [localeResolutionCallback], and
  /// [supportedLocales] arguments correspond with the properties on
  /// [Navigator], [Localizations.delegates],
  /// [Localizations.localeListResolutionCallback],
  /// [Localizations.localeResolutionCallback], and [Localizations.supportedLocales],
  /// respectively.
  ///
  /// The [supportedLocales] argument must be a list with at least one
  /// element. By default, the first element is used as the [locale] if the
  /// user's preferred locale couldn't be determined or wasn't in the list. To
  /// override this behavior, use [localeResolutionCallback] or
  /// [localeListResolutionCallback].
  ///
  /// The [showPerformanceOverlay], [checkerboardRasterCacheImages],
  /// [checkerboardOffscreenLayers], [showSemanticsDebugger], and
  /// [debugShowWidgetInspector] arguments correspond to the properties of the same
  /// name on [WidgetsApp.new].
  ///
  /// The [routeInformationProvider] and [routeInformationParser] arguments
  /// correspond with the same properties on [Router].
  ///
  /// The [routerDelegate] argument corresponds with the property of the same
  /// name on [Router]. It is mutually exclusive with [home], [routes],
  /// [onGenerateRoute], [onGenerateInitialRoutes], [onUnknownRoute],
  /// [initialRoute], and [navigatorObservers].
  ///
  /// The [backButtonDispatcher] argument corresponds with the property of the
  /// same name on [Router]. It is mutually exclusive with [builder].
  ///
  /// The [useInheritedMediaQuery] argument causes the app to use the
  /// [MediaQuery] from the inherited context, or to create a new one
  /// if no [MediaQuery] is found in the inherited context. This is
  /// different from the default behavior, which always creates a new
  /// [MediaQuery].
  WidgetsApp({ // Coverage excludes this line because it's not executed in tests.
    super.key,
    this.navigatorKey,
    this.onGenerateRoute,
    this.onGenerateInitialRoutes,
    this.onUnknownRoute,
    this.navigatorObservers = const <NavigatorObserver>[],
    this.initialRoute,
    this.pageRouteBuilder,
    this.home,
    this.routes = const <String, WidgetBuilder>{},
    this.builder,
    this.title = '',
    this.onGenerateTitle,
    this.textStyle,
    this.color,
    this.locale,
    this.localizationsDelegates,
    this.localeListResolutionCallback,
    this.localeResolutionCallback,
    this.supportedLocales = const <Locale>[Locale('en', 'US')],
    this.showPerformanceOverlay = false,
    this.checkerboardRasterCacheImages = false,
    this.checkerboardOffscreenLayers = false,
    this.showSemanticsDebugger = false,
    this.debugShowCheckedModeBanner = true,
    this.debugShowWidgetInspector = false,
    this.inspectorSelectButtonBuilder,
    this.shortcuts,
    this.actions,
    this.restorationScopeId,
    this.useInheritedMediaQuery = false,
    this.routeInformationProvider,
    this.routeInformationParser,
    this.routerDelegate,
    this.backButtonDispatcher,
    this.routerConfig,
    this.sharedAppData,
  }) : assert(
         routerDelegate == null ||
         (navigatorObservers.isEmpty &&
          home == null &&
          routes.isEmpty &&
          onGenerateRoute == null &&
          onUnknownRoute == null &&
          builder != null &&
          initialRoute == null &&
          navigatorKey == null &&
          onGenerateInitialRoutes == null),
         'If routerDelegate is non-null, then none of the following may be '
         'set: navigatorObservers, home, routes, onGenerateRoute, '
         'onUnknownRoute, initialRoute, navigatorKey, or onGenerateInitialRoutes.',
       ),
       assert(
         routerConfig == null ||
         (routeInformationProvider == null &&
          routeInformationParser == null &&
          routerDelegate == null &&
          backButtonDispatcher == null),
         'If routerConfig is non-null, then none of the following may be '
         'set: routeInformationProvider, routeInformationParser, routerDelegate, '
         'or backButtonDispatcher.',
       ),
       assert(
         home == null ||
         routes.isEmpty ||
         routes[Navigator.defaultRouteName] == null,
         'If both home and routes are non-null, then routes cannot contain an '
         'entry for "/", since it would be redundant with the home widget.',
       ),
       assert(
         builder != null ||
         home != null ||
         routes.isNotEmpty ||
         onGenerateRoute != null ||
         onUnknownRoute != null ||
         routerDelegate != null ||
         routerConfig != null,
         'Either the home argument, routes, onGenerateRoute, onUnknownRoute, '
         'routerDelegate, or routerConfig arguments must be provided.',
       ),
       assert(
         (home != null ||
          routes.isNotEmpty ||
          onGenerateRoute != null ||
          onUnknownRoute != null) ||
         (routerDelegate != null || routerConfig != null),
         'If neither home, routes, onGenerateRoute, nor onUnknownRoute are '
         'provided, the routerDelegate or routerConfig arguments must be non-null.',
       ),
       assert(
         (routerDelegate != null || routerConfig != null) ||
         pageRouteBuilder != null ||
         home == null && routes.isEmpty && onGenerateRoute == null && onUnknownRoute == null,
         'If neither routerDelegate nor routerConfig are provided, the '
         'pageRouteBuilder argument must be provided if either the home, routes, '
         'onGenerateRoute, or onUnknownRoute arguments are provided.',
       ),
       assert(
         supportedLocales.isNotEmpty,
         'supportedLocales must have at least one locale',
       ),
       assert(
         backButtonDispatcher == null || routerDelegate != null || routerConfig != null,
         'If backButtonDispatcher is non-null, routerDelegate or routerConfig must '
         'also be non-null.',
       ),
       assert(
         routeInformationProvider == null || routeInformationParser != null,
         'If routeInformationProvider is non-null, routeInformationParser must '
         'also be non-null.',
       ),
       routeInformationProvider = routeInformationProvider ?? routerConfig?.routeInformationProvider,
       routeInformationParser = routeInformationParser ?? routerConfig?.routeInformationParser,
       routerDelegate = routerDelegate ?? routerConfig?.routerDelegate,
       backButtonDispatcher = backButtonDispatcher ?? routerConfig?.backButtonDispatcher;

  /// Creates a [WidgetsApp] that uses the [Router] instead of a [Navigator].
  ///
  /// The [routeInformationProvider], [routeInformationParser], [routerDelegate],
  /// [title], [color], and [supportedLocales] arguments must not be null.
  ///
  /// The [supportedLocales] argument must be a list with at least one
  /// element. By default, the first element is used as the [locale] if the
  /// user's preferred locale couldn't be determined or wasn't in the list. To
  /// override this behavior, use [localeResolutionCallback] or
  /// [localeListResolutionCallback].
  ///
  /// The [routeInformationProvider] and [routeInformationParser] arguments
  /// correspond with the same properties on [Router].
  ///
  /// The [routerDelegate] argument corresponds with the property of the same
  /// name on [Router]. It is mutually exclusive with [home], [routes],
  /// [onGenerateRoute], [onGenerateInitialRoutes], [onUnknownRoute],
  /// [initialRoute], and [navigatorObservers].
  ///
  /// The [backButtonDispatcher] argument corresponds with the property of the
  /// same name on [Router]. It is mutually exclusive with [builder].
  ///
  /// The [useInheritedMediaQuery] argument causes the app to use the
  /// [MediaQuery] from the inherited context, or to create a new one
  /// if no [MediaQuery] is found in the inherited context. This is
  /// different from the default behavior, which always creates a new
  /// [MediaQuery].
  WidgetsApp.router({
    super.key,
    this.routeInformationProvider,
    required RouteInformationParser<Object> this.routeInformationParser,
    required RouterDelegate<Object> this.routerDelegate,
    this.backButtonDispatcher,
    this.routerConfig,
    this.builder,
    this.title = '',
    this.onGenerateTitle,
    this.textStyle,
    required this.color,
    this.locale,
    this.localizationsDelegates,
    this.localeListResolutionCallback,
    this.localeResolutionCallback,
    this.supportedLocales = const <Locale>[Locale('en', 'US')],
    this.showPerformanceOverlay = false,
    this.checkerboardRasterCacheImages = false,
    this.checkerboardOffscreenLayers = false,
    this.showSemanticsDebugger = false,
    this.debugShowCheckedModeBanner = true,
    this.debugShowWidgetInspector = false,
    this.inspectorSelectButtonBuilder,
    this.shortcuts,
    this.actions,
    this.restorationScopeId,
    this.useInheritedMediaQuery = false,
    this.sharedAppData,
  }) : assert(
         routerConfig == null ||
         (routeInformationProvider == null &&
          routeInformationParser == null &&
          routerDelegate == null &&
          backButtonDispatcher == null),
         'If routerConfig is non-null, then none of the following may be '
         'set: routeInformationProvider, routeInformationParser, routerDelegate, '
         'or backButtonDispatcher.',
       ),
       assert(
         supportedLocales.isNotEmpty,
         'supportedLocales must have at least one locale',
       ),
       assert(
         routeInformationProvider == null || routeInformationParser != null,
         'If routeInformationProvider is non-null, routeInformationParser must '
         'also be non-null.',
       ),
       routeInformationProvider = routeInformationProvider ?? routerConfig?.routeInformationProvider,
       routeInformationParser = routeInformationParser ?? routerConfig?.routeInformationParser as RouteInformationParser<Object>?,
       routerDelegate = routerDelegate ?? routerConfig?.routerDelegate as RouterDelegate<Object>?,
       backButtonDispatcher = backButtonDispatcher ?? routerConfig?.backButtonDispatcher,
       navigatorObservers = const <NavigatorObserver>[],
       initialRoute = null,
       pageRouteBuilder = null,
       home = null,
       onGenerateRoute = null,
       onGenerateInitialRoutes = null,
       onUnknownRoute = null,
       navigatorKey = null,
       routes = const <String, WidgetBuilder>{};

  /// {@template flutter.widgets.widgetsApp.navigatorKey}
  /// A key to use when building the [Navigator].
  ///
  /// If a [navigatorKey] is specified, the [Navigator] can be directly
  /// manipulated without first obtaining it from a [BuildContext] via
  /// [Navigator.of]: from the [navigatorKey], use the [GlobalKey.currentState]
  /// getter.
  ///
  /// If this is changed, a new [Navigator] will be created, losing all the
  /// application state in the process; in that case, the [navigatorObservers]
  /// must also be changed, since the previous observers will be attached to the
  /// previous navigator.
  ///
  /// The [Navigator] is only built if [onGenerateRoute] or [home] is provided.
  /// {@endtemplate}
  final GlobalKey<NavigatorState>? navigatorKey;

  /// {@template flutter.widgets.widgetsApp.onGenerateRoute}
  /// The route generator callback used when the app is navigated to a
  /// named route.
  ///
  /// If this returns null when building the routes to handle the specified
  /// [initialRoute], then all the routes are discarded and
  /// [Navigator.defaultRouteName] is used instead (`/`). See [initialRoute].
  ///
  /// During normal app operation, the [onGenerateRoute] callback will only be
  /// applied to route names pushed by the application, and so should never
  /// return null.
  ///
  /// This is used if [routes] does not contain the requested route.
  ///
  /// The [Navigator] is only built if routes are provided (either via [home],
  /// [routes], [onGenerateRoute], or [onUnknownRoute]); if they are not,
  /// [builder] must be provided instead.
  ///
  /// The [pageRouteBuilder] argument must be provided if this callback is
  /// provided.
  /// {@endtemplate}
  final RouteFactory? onGenerateRoute;

  /// {@template flutter.widgets.widgetsApp.onGenerateInitialRoutes}
  /// The routes generator callback used for generating initial routes if
  /// [initialRoute] is provided.
  ///
  /// If this parameter is not provided or if it returns null, the [Navigator]
  /// will generate a route using [onGenerateRoute] instead.
  ///
  /// The [Navigator] is only built if routes are provided (either via [home],
  /// [routes], [onGenerateRoute], or [onUnknownRoute]); if they are not,
  /// [builder] must be provided instead.
  ///
  /// The [pageRouteBuilder] argument must be provided if this callback is
  /// provided.
  /// {@endtemplate}
  final InitialRouteListFactory? onGenerateInitialRoutes;

  /// {@template flutter.widgets.widgetsApp.onUnknownRoute}
  /// Called when [onGenerateRoute] fails to generate a route, except for the
  /// [initialRoute].
  ///
  /// This callback is typically used for error handling. For example, this
  /// callback might always generate a "not found" page that describes the route
  /// that wasn't found.
  ///
  /// Unknown routes can arise either from errors in the app or from external
  /// requests to push routes, such as from Android intents.
  ///
  /// The [Navigator] is only built if routes are provided (either via [home],
  /// [routes], [onGenerateRoute], or [onUnknownRoute]); if they are not,
  /// [builder] must be provided instead.
  ///
  /// The [pageRouteBuilder] argument must be provided if this callback is
  /// provided.
  /// {@endtemplate}
  final RouteFactory? onUnknownRoute;

  /// {@template flutter.widgets.widgetsApp.navigatorObservers}
  /// The list of observers for the [Navigator].
  ///
  /// This list must be replaced if [navigatorKey] is changed.
  ///
  /// The [Navigator] is only built if routes are provided (either via [home],
  /// [routes], [onGenerateRoute], or [onUnknownRoute]); if they are not,
  /// [builder] must be provided instead.
  /// {@endtemplate}
  final List<NavigatorObserver> navigatorObservers;

  /// {@template flutter.widgets.widgetsApp.routeInformationProvider}
  /// A object to provide route information through the [Router] widget.
  ///
  /// This is used by the [Router] to setup the [RouteInformationParser] and
  /// [RouterDelegate] with route information.
  ///
  /// If this property is non-null, the [Router] widget will be built using this
  /// [routeInformationProvider], [routeInformationParser], and [routerDelegate].
  /// The [Navigator] widget will not be built directly.
  ///
  /// The [routeInformationParser] and [routerDelegate] arguments must be
  /// non-null if this property is non-null.
  /// {@endtemplate}
  final RouteInformationProvider? routeInformationProvider;

  /// {@template flutter.widgets.widgetsApp.routeInformationParser}
  /// A delegate to parse route information from the system.
  ///
  /// This is used by the [Router] to parse incoming route information, and is
  /// used with [routerDelegate] to build the [Router] widget.
  ///
  /// If this property is non-null, the [Router] widget will be built using this
  /// [routeInformationParser], [routeInformationProvider], and [routerDelegate].
  /// The [Navigator] widget will not be built directly.
  ///
  /// The [routerDelegate] argument must be non-null if this property is non-null.
  /// {@endtemplate}
  final RouteInformationParser<Object>? routeInformationParser;

  /// {@template flutter.widgets.widgetsApp.routerDelegate}
  /// A delegate for building the [Router] widget's widget tree.
  ///
  /// This is used by the [Router] to build the application widget tree, and is
  /// used with [routeInformationParser] to build the [Router] widget.
  ///
  /// If this property is non-null, the [Router] widget will be built using this
  /// [routerDelegate], [routeInformationParser], and [routeInformationProvider].
  /// The [Navigator] widget will not be built directly.
  ///
  /// The [routeInformationParser] argument must be non-null if this property is
  /// non-null.
  /// {@endtemplate}
  final RouterDelegate<Object>? routerDelegate;

  /// {@template flutter.widgets.widgetsApp.backButtonDispatcher}
  /// A delegate for handling the back button.
  ///
  /// This is used by the [Router] to handle the back button, and is used with
  /// [routerDelegate] to build the [Router] widget.
  ///
  /// If this property is null, the [Router] will create a
  /// [RootBackButtonDispatcher] by default.
  /// {@endtemplate}
  final BackButtonDispatcher? backButtonDispatcher;

  /// {@template flutter.widgets.widgetsApp.routerConfig}
  /// A convenience property for initializing a [Router] widget.
  ///
  /// If this property is non-null, the [Router] widget will be built using the
  /// [RouterConfig.routeInformationProvider], [RouterConfig.routeInformationParser],
  /// [RouterConfig.routerDelegate], and [RouterConfig.backButtonDispatcher].
  /// The [Navigator] widget will not be built directly.
  ///
  /// If this property is non-null, the [routeInformationProvider],
  /// [routeInformationParser], [routerDelegate], and [backButtonDispatcher]
  /// arguments must be null.
  /// {@endtemplate}
  final RouterConfig<Object>? routerConfig;

  /// {@template flutter.widgets.widgetsApp.initialRoute}
  /// The name of the first route to show, if a [Navigator] is built.
  ///
  /// Defaults to [Navigator.defaultRouteName].
  ///
  /// Setting this to a route name that is handled by [onGenerateInitialRoutes]
  /// will cause [onGenerateInitialRoutes] to generate that route and any
  /// subroutes.
  ///
  /// If [onGenerateInitialRoutes] is null, setting this to a route name that's
  /// handled by [onGenerateRoute] will cause [onGenerateRoute] to generate the
  /// initial route.
  ///
  /// If both [onGenerateInitialRoutes] and [onGenerateRoute] are null, setting
  /// this to a name that's handled by [routes] will cause that named route to
  /// be the initial route.
  ///
  /// The [Navigator] is only built if routes are provided (either via [home],
  /// [routes], [onGenerateRoute], or [onUnknownRoute]); if they are not,
  /// [builder] must be provided instead.
  ///
  /// The [pageRouteBuilder] argument must be provided if this argument is
  /// provided.
  /// {@endtemplate}
  final String? initialRoute;

  /// {@template flutter.widgets.widgetsApp.pageRouteBuilder}
  /// A builder for the [PageRoute]s that are built by [onGenerateRoute],
  /// [onGenerateInitialRoutes], and [routes].
  ///
  /// If this is not specified, a [PageRoute] subclass like the one used by
  /// [MaterialApp] or [CupertinoApp] is used.
  ///
  /// The [Navigator] is only built if routes are provided (either via [home],
  /// [routes], [onGenerateRoute], or [onUnknownRoute]); if they are not,
  /// [builder] must be provided instead.
  ///
  /// This is used if [home], [routes], [onGenerateRoute], or [onUnknownRoute]
  /// are provided.
  /// {@endtemplate}
  final PageRouteFactory? pageRouteBuilder;

  /// {@template flutter.widgets.widgetsApp.home}
  /// The widget for the default route of the app ([Navigator.defaultRouteName],
  /// which is `/`).
  ///
  /// This is the route that is displayed first when the application is started
  /// normally, unless [initialRoute] is specified. It's also the route that's
  /// displayed if the [initialRoute] can't be displayed.
  ///
  /// To be able to directly call [Theme.of], [MediaQuery.of], etc, in the code
  /// that sets the [home] argument in the constructor, you can use a [Builder]
  /// widget to get a [BuildContext].
  ///
  /// If [home] is specified, then [routes] must not include an entry for `/`,
  /// as [home] takes its place.
  ///
  /// The [Navigator] is only built if routes are provided (either via [home],
  /// [routes], [onGenerateRoute], or [onUnknownRoute]); if they are not,
  /// [builder] must be provided instead.
  ///
  /// The [pageRouteBuilder] argument must be provided if this argument is
  /// provided.
  /// {@endtemplate}
  final Widget? home;

  /// The application's top-level routing table.
  ///
  /// When a named route is pushed with [Navigator.pushNamed], the route name is
  /// looked up in this map. If the name is present, the associated
  /// [WidgetBuilder] is used to construct a [PageRoute] specified by
  /// [pageRouteBuilder] to perform an appropriate transition, including [Hero]
  /// animations, to the new route.
  ///
  /// {@template flutter.widgets.widgetsApp.routes}
  /// If the app only has one page, then you can specify it using [home] instead.
  ///
  /// If [home] is specified, then it implies an entry in this table for the
  /// [Navigator.defaultRouteName] route (`/`), and it is an error to
  /// redundantly provide such a route in the [routes] table.
  ///
  /// If a route is requested that is not specified in this table (or by
  /// [home]), then the [onGenerateRoute] callback is called to build the page
  /// instead.
  ///
  /// The [Navigator] is only built if routes are provided (either via [home],
  /// [routes], [onGenerateRoute], or [onUnknownRoute]); if they are not,
  /// [builder] must be provided instead.
  ///
  /// The [pageRouteBuilder] argument must be provided if this argument is
  /// provided.
  /// {@endtemplate}
  final Map<String, WidgetBuilder> routes;

  /// {@template flutter.widgets.widgetsApp.builder}
